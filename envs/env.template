# Template for the backend configuration file.
#
# Copy this file to envs/<target>.env (dev, prod, test, local) and fill in the values. The Makefile
# symlinks the chosen one to .env; everything under envs/ except this template is gitignored.
#
# Values shown are the defaults from src/triton_serve/config/schema.py, so a commented-out key
# means "the default applies". Only the keys marked REQUIRED have no default and must be set.

# ------------------------------------------------------------------------------------------------
# Deployment target
# ------------------------------------------------------------------------------------------------
# dev | prod | test. Selects the compose overlay and the container build stage. In prod the API runs
# under gunicorn, otherwise uvicorn with --reload.
TARGET=dev
# Log level for the API, the workers and the entrypoint scripts.
LOG_LEVEL=info
# Run `alembic upgrade head` on container start.
RUN_MIGRATIONS=true
# Gunicorn workers; prod only.
# API_WORKERS=4

# ------------------------------------------------------------------------------------------------
# API
# ------------------------------------------------------------------------------------------------
# Master API keys, comma-separated inside brackets: ["key-one","key-two"]. The first is the one the
# test suite authenticates with. Every service's Traefik config grants these keys access.
API_KEYS=["change-me"]
API_ROOT_PATH=/
# PROJECT_NAME=triton-serve
# API_TITLE=Triton Serve
# API_DESCRIPTION=Triton Serve API

# Where the API is reachable from the workers and the test suite. REQUIRED.
BACKEND_HOST=backend
BACKEND_PORT=5000

# ------------------------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------------------------
# REQUIRED: user, password and host have no defaults.
DATABASE_USER=postgres
DATABASE_PASS=change-me
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=serve_db
# Consumed by the postgres container itself; keep it equal to DATABASE_NAME.
POSTGRES_DB=serve_db

# ------------------------------------------------------------------------------------------------
# Model repository
# ------------------------------------------------------------------------------------------------
# Named volume or host path holding the model repository.
# REPOSITORY_PATH=/var/serve/models
# Subdirectory a bundle is extracted into.
# REPOSITORY_DIRNAME=model_repository
# Where the generated Traefik config files are written.
# CONFIGS_PATH=/var/serve/configs
# local | azure. Only local is implemented today.
# STORAGE_TYPE=local

# ------------------------------------------------------------------------------------------------
# Services
# ------------------------------------------------------------------------------------------------
# Docker network and models volume the service containers are attached to. These must match the
# compose project's names, which are prefixed with the project directory.
SERVICE_NETWORK=triton-serve_default
SERVICE_VOLUME=triton-serve_models
# Base image used when a service is created without an explicit docker_image.
# SERVICE_DEFAULT_IMAGE=ghcr.io/links-ads/serve-triton:23.07-py3
# URL prefix Traefik routes services under, e.g. /serve. Empty means the root.
# SERVICE_PREFIX=
# Crash budget: recovery attempts before a service is marked FAILED.
# SERVICE_MAX_RESTART_ATTEMPTS=3
# Seconds a recovered service must stay READY to earn its crash budget back. Also the retry cap.
# SERVICE_RESTART_COOLDOWN=600
# Base of the exponential backoff between recovery attempts, in seconds.
# SERVICE_RESTART_BACKOFF_BASE=10
# Seconds a container without a healthcheck stays WARMING before it is considered up. Only used
# when a service defines no healthcheck; docker owns the verdict whenever one is configured.
# SERVICE_BOOT_GRACE=30

# ------------------------------------------------------------------------------------------------
# Sentinel worker
# ------------------------------------------------------------------------------------------------
# Reconcile tick, in seconds. The loop is a cheap DB read plus a docker inspect per service.
# SENTINEL_POLL_INTERVAL=10
# Docker client timeout for the reconciler, in seconds. Short on purpose: a slow daemon must fail
# fast rather than block the tick.
# DOCKER_TIMEOUT=10
# Broker queue purge: how often to run, and how old a message must be to be purged.
# PURGE_MESSAGE_SCHEDULE=86400
# OLDER_THAN_HOURS_TO_PURGE=24

# ------------------------------------------------------------------------------------------------
# Image registry
# ------------------------------------------------------------------------------------------------
# Private registry for built runtime images. Both credentials belong to the org's dedicated machine
# account: the push token needs read:packages + write:packages, the pull token only read:packages.
# These must be classic PATs — fine-grained tokens do not support the packages scopes.
# Empty tokens degrade to an unauthenticated pull rather than failing at startup.
# REGISTRY_URL=ghcr.io
# REGISTRY_NAMESPACE=links-ads
# REGISTRY_IMAGE_NAME=serve-runtime
REGISTRY_PUSH_USERNAME=
REGISTRY_PUSH_TOKEN=
REGISTRY_PULL_USERNAME=
REGISTRY_PULL_TOKEN=
# Docker client timeout for the builder, in seconds. A build streams for minutes, so it cannot
# share the reconciler's fail-fast timeout.
# IMAGE_BUILD_TIMEOUT=1800

# ------------------------------------------------------------------------------------------------
# Container build args
# ------------------------------------------------------------------------------------------------
# Only read at image build time, not at runtime.
# PYTHON_VERSION=3.14.0
# UV_VERSION=0.10.7
# NVIDIA_DRIVER_VERSION=550.90.07
# UBUNTU_VERSION=22.04
# nvidia to expose GPUs to the backend container, runc otherwise.
# DOCKER_RUNTIME=runc

# ------------------------------------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------------------------------------
# SSH url of a model repository to exercise the git upload path. Those tests skip when unset.
# TEST_GIT_REPO=
